PORT=3011
# Signs session cookies. Set it so logins survive a restart; without it a random one is used.
SESSION_SECRET=
# The first boot seeds one owner account from these.
ADMIN_EMAIL=owner@example.com
ADMIN_NAME=Owner
ADMIN_PASSWORD=
# Where the SQLite file lives (default: ./data/chef.db)
DB_PATH=
# Demo mode: resets all business data to the seed set every DEMO_RESET_MIN minutes
DEMO_MODE=0
DEMO_RESET_MIN=20
